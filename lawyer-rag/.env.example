# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:e2b
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION_NAME=sri_lanka_legal_acts

# Flask
FLASK_PORT=5000
FLASK_DEBUG=true

# RAG Configuration
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K_RESULTS=6

# Acts source directory (absolute path to your Acts folder)
ACTS_SOURCE_DIR=../Acts
