generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LAWYER
  CLIENT
}

enum InquiryStatus {
  PENDING
  CONTACTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  passwordHash    String
  fullName        String?
  profileImageUrl String?
  role            Role               @default(CLIENT)
  createdAt       DateTime           @default(now())
  profile         LawyerProfile?
  application     LawyerApplication?
  reviews         Review[]           @relation("ReviewAuthor")
}

model LawyerApplication {
  id          String            @id @default(uuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(DRAFT)
  currentStep Int               @default(1)

  // Storing draft info flexibly before finalizing a row in LawyerProfile
  draftData Json @default("{}")

  adminNotes  String?
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

model LawyerProfile {
  id                String      @id @default(uuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  baslNumber        String      @unique
  nic               String?
  address           String?
  contactPhone      String?
  profileImageUrl   String?
  bio               String?
  practiceAreas     String[]
  languages         String[]
  district          String?
  baseFeeRange      String?
  gender            String?
  yearsOfExperience Int?
  practiceType      String?
  courts            String[]
  isNotary          Boolean     @default(false)
  licenseImageUrl   String?
  identityImageUrl  String?
  isVerified        Boolean     @default(false)
  subscriptionId    String?
  Subscription     Subscription[]
  
  inquiries         Inquiry[]
  articles          Article[]
  reviews           Review[]
  paidPromos        PaidPromo[]
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  tier          Int      @default(0)
  monthlyAmount Int
  yearlyAmount  Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  subscriptionDetails SubscriptionDetails[]
}

model Subscription {
  id          String   @id @default(uuid())
  lawyerId    String
  lawyer      LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  planId      String
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])

  status      SubscriptionStatus @default(ACTIVE)

  startDate   DateTime @default(now())
  endDate     DateTime?
  nextBilling DateTime

  autoRenew   Boolean  @default(true)

  cycles      SubscriptionCycle[]

  createdAt   DateTime @default(now())
}

model SubscriptionCycle {
  id              String   @id @default(uuid())

  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  startDate       DateTime
  endDate         DateTime

  status          SubscriptionStatus

  invoices        Invoice[]
}

model Invoice {
  id                 String   @id @default(uuid())

  subscriptionCycleId String
  subscriptionCycle   SubscriptionCycle @relation(fields: [subscriptionCycleId], references: [id], onDelete: Cascade)

  amount             Int
  status             PaymentStatus @default(UNPAID)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SubscriptionDetails {
  id          String        @id @default(uuid())
  subscriptionId    String
  subscription      SubscriptionPlan @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  details     String
}


model Inquiry {
  id          String        @id @default(uuid())
  lawyerId    String
  lawyer      LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  clientName  String
  clientPhone String
  clientEmail String
  message     String
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

model Article {
  id        String        @id @default(uuid())
  authorId  String
  author    LawyerProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  slug      String        @unique
  content   String
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime      @default(now())
}

model Review {
  id           String        @id @default(uuid())
  lawyerId     String
  lawyer       LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewer     User?         @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName String
  rating       Int
  comment      String
  isApproved   Boolean       @default(false)
  createdAt    DateTime      @default(now())
}

enum PromoStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PAID
  UNPAID
  PENDING
}

model PaidPromo {
  id            String        @id @default(uuid())
  lawyerId      String
  lawyer        LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  fromDate      DateTime
  toDate        DateTime
  status        PromoStatus   @default(INACTIVE)
  paymentStatus PaymentStatus @default(UNPAID)
  invoiceId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
