generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LAWYER
  CLIENT
}

enum InquiryStatus {
  PENDING
  CONTACTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  REMOVED
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum CommunityRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberRole {
  MEMBER
  MODERATOR
  CREATOR
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum SubscriptionTier {
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  passwordHash    String
  fullName        String?
  profileImageUrl String?
  role            Role               @default(CLIENT)
  createdAt       DateTime           @default(now())
  profile         LawyerProfile?
  application     LawyerApplication?
  reviews         Review[]           @relation("ReviewAuthor")
  conversations   ConversationParticipant[]
  messages        Message[]

  // Community Hub relations
  communities        CommunityMember[]
  createdCommunities Community[]        @relation("CommunityCreator")
  communityRequests  CommunityRequest[] @relation("CommunityRequester")
  posts              Post[]             @relation("PostAuthor")
  comments           Comment[]          @relation("CommentAuthor")
  votes              Vote[]             @relation("UserVotes")
  reports            Report[]           @relation("UserReports")
}

model LawyerApplication {
  id          String            @id @default(uuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(DRAFT)
  currentStep Int               @default(1)

  // Storing draft info flexibly before finalizing a row in LawyerProfile
  draftData Json @default("{}")

  adminNotes  String?
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

model LawyerProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  baslNumber        String         @unique
  nic               String?
  address           String?
  contactPhone      String?
  profileImageUrl   String?
  bio               String?
  practiceAreas     String[]
  languages         String[]
  district          String?
  baseFeeRange      String?
  gender            String?
  yearsOfExperience Int?
  practiceType      String?
  courts            String[]
  isNotary          Boolean        @default(false)
  licenseImageUrl   String?
  identityImageUrl  String?
  isVerified        Boolean        @default(false)
  subscriptionId    String?
  Subscription      Subscription[]
  invoices          Invoice[]      @relation("InvoiceLawyer")

  inquiries  Inquiry[]
  articles   Article[]
  reviews    Review[]
  paidPromos PaidPromo[]
}

model SubscriptionPlan {
  id            String           @id @default(uuid())
  name          String
  tier          SubscriptionTier
  monthlyAmount Int
  yearlyAmount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions       Subscription[]
  subscriptionDetails SubscriptionDetails[]
  invoices            Invoice[]
}

model Subscription {
  id       String        @id @default(uuid())
  lawyerId String
  lawyer   LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  roleId String
  role   SubscriptionRole @relation(fields: [roleId], references: [id])

  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)

  startDate   DateTime  @default(now())
  endDate     DateTime?
  nextBilling DateTime

  autoRenew Boolean @default(true)

  invoiceId String?  @unique
  invoice   Invoice? @relation("SubscriptionInvoice", fields: [invoiceId], references: [id])

  cycles SubscriptionCycle[]
  usages FeatureUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionCycle {
  id String @id @default(uuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  status SubscriptionStatus

  invoices Invoice[]
}

model Invoice {
  id String @id @default(uuid())

  lawyerId String
  lawyer   LawyerProfile? @relation("InvoiceLawyer", fields: [lawyerId], references: [id], onDelete: Cascade)

  subscriptionCycleId String?
  subscriptionCycle   SubscriptionCycle? @relation(fields: [subscriptionCycleId], references: [id], onDelete: SetNull)

  subscriptionId String?
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  amount          Int
  status          PaymentStatus @default(PENDING)
  paymentReason   String        @default("Subscription payment")
  receiptImageUrl String?
  paymentDetails  Json?
  adminNotes      String?

  remarks         InvoiceRemark[] @relation("InvoiceRemarks")
  subscription Subscription? @relation("SubscriptionInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceRemark {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation("InvoiceRemarks", fields: [invoiceId], references: [id], onDelete: Cascade)
  
  remark    String
  isForLawyer Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionDetails {
  id             String           @id @default(uuid())
  subscriptionId String
  subscription   SubscriptionPlan @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  details        String
}

model Inquiry {
  id          String        @id @default(uuid())
  lawyerId    String
  lawyer      LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  clientName  String
  clientPhone String
  clientEmail String
  message     String
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

model Article {
  id        String        @id @default(uuid())
  authorId  String
  author    LawyerProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  slug      String        @unique
  content   String
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime      @default(now())
}

model Review {
  id           String        @id @default(uuid())
  lawyerId     String
  lawyer       LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewer     User?         @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName String
  rating       Int
  comment      String
  isApproved   Boolean       @default(false)
  createdAt    DateTime      @default(now())
}

enum PromoStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PAID
  UNPAID
  PENDING
  RESUBMIT
  CANCELLED
}

model PaidPromo {
  id            String        @id @default(uuid())
  lawyerId      String
  lawyer        LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  fromDate      DateTime
  toDate        DateTime
  status        PromoStatus   @default(INACTIVE)
  paymentStatus PaymentStatus @default(UNPAID)
  invoiceId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ============= Subscription RBAC System =============

model SubscriptionRole {
  id          String           @id @default(uuid())
  name        SubscriptionTier
  description String?

  permissions   SubscriptionRolePermission[]
  subscriptions Subscription[]
  featureLimits FeatureLimitConfig[]         @relation(name: "RoleFeatureLimits")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "create_article", "post_inquiry", "access_chat"
  slug        String  @unique // URL-friendly version
  description String?
  category    String // e.g., "articles", "inquiries", "chat"

  roles SubscriptionRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionRolePermission {
  id     String           @id @default(uuid())
  roleId String
  role   SubscriptionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model Feature {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "articles_per_month", "inquiries_per_month"
  slug        String  @unique
  description String?
  unit        String // e.g., "count", "GB", "hours"

  usages FeatureUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureLimitConfig {
  id     String           @id @default(uuid())
  roleId String
  role   SubscriptionRole @relation(name: "RoleFeatureLimits", fields: [roleId], references: [id], onDelete: Cascade)

  featureName String // e.g., "articles_per_month", "inquiries_per_month"
  limit       Int // e.g., 10, 50, unlimited if -1
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, featureName])
}

model FeatureUsage {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id])

  usage Int @default(0)

  // For monthly/yearly reset tracking
  billingCycleStart DateTime
  billingCycleEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, featureId, billingCycleStart])
}

// ============= Chat System =============

model Conversation {
  id           String                    @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}

// ============= Community & Knowledge Hub =============

model Community {
  id          String          @id @default(uuid())
  name        String          @unique
  displayName String
  description String
  rules       String?
  icon        String?
  coverImage  String?
  category    String
  status      CommunityStatus @default(ACTIVE)

  createdById String
  createdBy   User @relation("CommunityCreator", fields: [createdById], references: [id])

  members  CommunityMember[]
  posts    Post[]

  postCount   Int @default(0)
  memberCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityMember {
  id          String     @id @default(uuid())
  communityId String
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([communityId, userId])
}

model CommunityRequest {
  id          String                 @id @default(uuid())
  requesterId String
  requester   User                   @relation("CommunityRequester", fields: [requesterId], references: [id])
  name        String
  displayName String
  description String
  category    String
  reason      String
  status      CommunityRequestStatus @default(PENDING)
  adminNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String     @id @default(uuid())
  communityId String
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title    String
  slug     String     @unique
  content  String
  excerpt  String?
  coverImage String?
  images   String[]
  language String     @default("en")

  status   PostStatus @default(PENDING_REVIEW)
  isPinned Boolean    @default(false)
  isLocked Boolean    @default(false)
  isAnonymous Boolean @default(false)

  upvotes      Int @default(0)
  downvotes    Int @default(0)
  score        Int @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)

  votes        Vote[]             @relation("PostVotes")
  comments     Comment[]
  reports      Report[]           @relation("PostReports")
  translations PostTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostTranslation {
  id      String  @id @default(uuid())
  postId  String
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale  String
  title   String
  content String
  excerpt String?
  isAuto  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, locale])
}

model Comment {
  id       String  @id @default(uuid())
  postId   String
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User    @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  content   String
  language  String  @default("en")
  isDeleted Boolean @default(false)

  upvotes   Int @default(0)
  downvotes Int @default(0)
  score     Int @default(0)

  votes        Vote[]               @relation("CommentVotes")
  reports      Report[]             @relation("CommentReports")
  translations CommentTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommentTranslation {
  id        String  @id @default(uuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  locale    String
  content   String
  isAuto    Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([commentId, locale])
}

model Vote {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)
  type   VoteType

  postId    String?
  post      Post?    @relation("PostVotes", fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation("CommentVotes", fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation("UserReports", fields: [reporterId], references: [id])
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  adminNotes  String?

  postId    String?
  post      Post?    @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation("CommentReports", fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
