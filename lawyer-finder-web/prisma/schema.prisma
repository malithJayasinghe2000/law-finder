generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LAWYER
  CLIENT
}

enum InquiryStatus {
  PENDING
  CONTACTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum SubscriptionTier {
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  passwordHash    String
  fullName        String?
  profileImageUrl String?
  role            Role               @default(CLIENT)
  createdAt       DateTime           @default(now())
  profile         LawyerProfile?
  application     LawyerApplication?
  reviews         Review[]           @relation("ReviewAuthor")
  conversations   ConversationParticipant[]
  messages        Message[]
  aiConversations AiConversation[]
}

model LawyerApplication {
  id          String            @id @default(uuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(DRAFT)
  currentStep Int               @default(1)

  // Storing draft info flexibly before finalizing a row in LawyerProfile
  draftData Json @default("{}")

  adminNotes  String?
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

model LawyerProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  baslNumber        String         @unique
  nic               String?
  address           String?
  contactPhone      String?
  profileImageUrl   String?
  bio               String?
  practiceAreas     String[]
  languages         String[]
  district          String?
  baseFeeRange      String?
  gender            String?
  yearsOfExperience Int?
  practiceType      String?
  courts            String[]
  isNotary          Boolean        @default(false)
  licenseImageUrl   String?
  identityImageUrl  String?
  isVerified        Boolean        @default(false)
  subscriptionId    String?
  Subscription      Subscription[]
  invoices          Invoice[]      @relation("InvoiceLawyer")

  inquiries  Inquiry[]
  articles   Article[]
  reviews    Review[]
  paidPromos PaidPromo[]
}

model SubscriptionPlan {
  id            String           @id @default(uuid())
  name          String
  tier          SubscriptionTier
  monthlyAmount Int
  yearlyAmount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions       Subscription[]
  subscriptionDetails SubscriptionDetails[]
  invoices            Invoice[]
}

model Subscription {
  id       String        @id @default(uuid())
  lawyerId String
  lawyer   LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  roleId String
  role   SubscriptionRole @relation(fields: [roleId], references: [id])

  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)

  startDate   DateTime  @default(now())
  endDate     DateTime?
  nextBilling DateTime

  autoRenew Boolean @default(true)

  invoiceId String?  @unique
  invoice   Invoice? @relation("SubscriptionInvoice", fields: [invoiceId], references: [id])

  cycles SubscriptionCycle[]
  usages FeatureUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionCycle {
  id String @id @default(uuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  status SubscriptionStatus

  invoices Invoice[]
}

model Invoice {
  id String @id @default(uuid())

  lawyerId String
  lawyer   LawyerProfile? @relation("InvoiceLawyer", fields: [lawyerId], references: [id], onDelete: Cascade)

  subscriptionCycleId String?
  subscriptionCycle   SubscriptionCycle? @relation(fields: [subscriptionCycleId], references: [id], onDelete: SetNull)

  subscriptionId String?
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  amount          Int
  status          PaymentStatus @default(PENDING)
  paymentReason   String        @default("Subscription payment")
  receiptImageUrl String?
  paymentDetails  Json?
  adminNotes      String?

  remarks         InvoiceRemark[] @relation("InvoiceRemarks")
  subscription Subscription? @relation("SubscriptionInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceRemark {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation("InvoiceRemarks", fields: [invoiceId], references: [id], onDelete: Cascade)
  
  remark    String
  isForLawyer Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionDetails {
  id             String           @id @default(uuid())
  subscriptionId String
  subscription   SubscriptionPlan @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  details        String
}

model Inquiry {
  id          String        @id @default(uuid())
  lawyerId    String
  lawyer      LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  clientName  String
  clientPhone String
  clientEmail String
  message     String
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

model Article {
  id        String        @id @default(uuid())
  authorId  String
  author    LawyerProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  slug      String        @unique
  content   String
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime      @default(now())
}

model Review {
  id           String        @id @default(uuid())
  lawyerId     String
  lawyer       LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewer     User?         @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName String
  rating       Int
  comment      String
  isApproved   Boolean       @default(false)
  createdAt    DateTime      @default(now())
}

enum PromoStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PAID
  UNPAID
  PENDING
  RESUBMIT
  CANCELLED
}

model PaidPromo {
  id            String        @id @default(uuid())
  lawyerId      String
  lawyer        LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  fromDate      DateTime
  toDate        DateTime
  status        PromoStatus   @default(INACTIVE)
  paymentStatus PaymentStatus @default(UNPAID)
  invoiceId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ============= Subscription RBAC System =============

model SubscriptionRole {
  id          String           @id @default(uuid())
  name        SubscriptionTier
  description String?

  permissions   SubscriptionRolePermission[]
  subscriptions Subscription[]
  featureLimits FeatureLimitConfig[]         @relation(name: "RoleFeatureLimits")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "create_article", "post_inquiry", "access_chat"
  slug        String  @unique // URL-friendly version
  description String?
  category    String // e.g., "articles", "inquiries", "chat"

  roles SubscriptionRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionRolePermission {
  id     String           @id @default(uuid())
  roleId String
  role   SubscriptionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model Feature {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "articles_per_month", "inquiries_per_month"
  slug        String  @unique
  description String?
  unit        String // e.g., "count", "GB", "hours"

  usages FeatureUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureLimitConfig {
  id     String           @id @default(uuid())
  roleId String
  role   SubscriptionRole @relation(name: "RoleFeatureLimits", fields: [roleId], references: [id], onDelete: Cascade)

  featureName String // e.g., "articles_per_month", "inquiries_per_month"
  limit       Int // e.g., 10, 50, unlimited if -1
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, featureName])
}

model FeatureUsage {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id])

  usage Int @default(0)

  // For monthly/yearly reset tracking
  billingCycleStart DateTime
  billingCycleEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, featureId, billingCycleStart])
}

// ============= Chat System =============

model Conversation {
  id           String                    @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}

// ============= AI Chat System =============

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("New Chat")
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiMessage {
  id               String         @id @default(uuid())
  conversationId   String
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String         // 'user' or 'assistant'
  content          String
  sources          Json?          // Legal source citations
  lawyerSuggestions Json?         // Suggested lawyers
  createdAt        DateTime       @default(now())
}
