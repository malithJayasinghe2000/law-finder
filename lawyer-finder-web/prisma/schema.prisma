generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LAWYER
  CLIENT
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  REMOVED
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum CommunityRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberRole {
  MEMBER
  MODERATOR
  CREATOR
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum SubscriptionTier {
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ============= Consultation & Booking System =============

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ConsultationMode {
  PHYSICAL
  ONLINE
  BOTH
}

/// Engagement request lifecycle (Phase 1).
///
/// A client does not "buy a consultation" — they request an engagement, the firm
/// screens it for conflicts, quotes a fee, and the client accepts or declines.
///
///   REQUESTED -> CONFLICT_CHECK -> QUOTED -> ACCEPTED -> SCHEDULED -> COMPLETED
///                      |             |           |
///                  DECLINED   QUOTE_EXPIRED  CANCELLED_*
///                             CLIENT_DECLINED
///
/// See docs/restructure/ROADMAP.md (Phase 1).
enum BookingStatus {
  REQUESTED // client submitted intake; not yet triaged
  CONFLICT_CHECK // firm screening for conflicts of interest
  DECLINED // firm declined (conflict, capacity, scope)
  QUOTED // fee + terms sent to the client
  QUOTE_EXPIRED // quote lapsed with no response
  CLIENT_DECLINED // client rejected the quote
  ACCEPTED // terms accepted; awaiting payment/scheduling
  SCHEDULED // appointment confirmed
  RESCHEDULE_REQUESTED // firm proposed a new date/time
  // IN_PROGRESS removed in Phase 2: nothing ever transitioned into it, so it was
  // a state the product claimed to have and did not. A consultation goes from
  // SCHEDULED straight to COMPLETED or NO_SHOW.
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_FIRM
  NO_SHOW
  DISPUTED
}

/// Outcome of the firm's conflict-of-interest screening.
enum ConflictCheckOutcome {
  CLEAR
  CONFLICT_FOUND
  NEEDS_REVIEW
}

/// How a quoted fee is calculated.
enum FeeBasis {
  CONSULTATION_FEE // flat fee for the consultation itself
  FIXED_FEE // fixed fee for a defined scope of work
  HOURLY
}

enum QuoteStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ConsultationPricingType {
  HOURLY
  PER_SESSION
}

// PAYHERE removed in Phase 0.3: it settled client fees into a platform merchant
// account. Clients pay the firm directly.
// See docs/restructure/LEGAL-GUARDRAILS.md (rule 2).
enum BookingPaymentMethod {
  BANK_TRANSFER
  PAY_AT_OFFICE
}

/// Refund lifecycle.
///
/// The firm holds the fee, so the firm makes the refund and the platform records
/// it. A record that rests on the firm's word alone is not enough — the client
/// confirms receipt, or disputes it.
///
///   NONE -> PENDING -> PROCESSED -> CONFIRMED   (client acknowledged receipt)
///                           |
///                           +----> DISPUTED     (client says it never arrived)
///                   -> DECLINED
///
/// See docs/restructure/LEGAL-GUARDRAILS.md (rule 2).
enum RefundStatus {
  NONE // No refund owed
  PENDING // Owed, not yet returned
  PROCESSED // The firm says it has returned the money
  CONFIRMED // The client confirms they received it
  DISPUTED // The client says they did not receive it
  DECLINED // Refund declined under the cancellation policy
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String?
  authProvider    AuthProvider @default(LOCAL)
  googleId        String?      @unique
  isEmailVerified Boolean      @default(false)
  fullName        String?
  profileImageUrl String?
  role            Role         @default(CLIENT)
  createdAt       DateTime     @default(now())

  /// Account lifecycle. See `UserStatus` — there are no hard deletes here,
  /// because a firm's matter file references the client for years.
  status   UserStatus @default(ACTIVE)
  /// Set when identifying fields were overwritten under a PDPA erasure request.
  erasedAt DateTime?

  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  profile             LawyerProfile?
  application         LawyerApplication?
  conversations       ConversationParticipant[]
  messages            Message[]
  /// Threads where this user is the client. Distinct from `conversations`,
  /// which is participation of any kind.
  clientConversations Conversation[]            @relation("ClientConversations")

  /// Firms this user belongs to. A user is normally a member of exactly one
  /// firm, but the schema does not forbid more (an attorney may be a consultant
  /// to a second practice).
  firmMemberships FirmMember[]

  // Community Hub relations
  communities        CommunityMember[]
  createdCommunities Community[]        @relation("CommunityCreator")
  communityRequests  CommunityRequest[] @relation("CommunityRequester")
  posts              Post[]             @relation("PostAuthor")
  comments           Comment[]          @relation("CommentAuthor")
  votes              Vote[]             @relation("UserVotes")
  reports            Report[]           @relation("UserReports")
  aiConversations    AiConversation[]

  // Consultation Booking relations
  bookings Booking[] @relation("ClientBookings")

  // Data protection (Phase 6)
  consents        ConsentRecord[]
  subjectRequests DataSubjectRequest[]
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// A "forgot password" link. Only a SHA-256 hash of the token is stored, so a
/// copy of this table cannot be used to reset anyone's password. One use, one
/// hour. `requestedById` is the admin who sent it from User Management, or null
/// when the person asked for it themselves.
model PasswordResetToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  requestedById String?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model LawyerApplication {
  id          String            @id @default(uuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(DRAFT)
  currentStep Int               @default(1)

  // Storing draft info flexibly before finalizing a row in LawyerProfile
  draftData Json @default("{}")

  adminNotes  String?
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

model LawyerProfile {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                  String
  baslNumber                String    @unique
  nic                       String?
  address                   String?
  contactPhone              String?
  onlineMeetingLink         String?
  profileImageUrl           String?
  bio                       String?
  practiceAreas             String[]
  languages                 String[]
  district                  String?
  latitude                  Float?
  longitude                 Float?
  // baseFeeRange removed in Phase 2. Publishing an attorney's fee indication in
  // a public directory is beyond the Rule 40 content limit and reads as
  // advertising. Fees are quoted per matter, to one client, in a Quote.
  // See docs/restructure/LEGAL-GUARDRAILS.md.
  gender                    String?
  yearsOfExperience         Int?
  practiceType              String?
  courts                    String[]
  isNotary                  Boolean   @default(false)
  licenseImageUrl           String?
  identityImageUrl          String?
  isVerified                Boolean   @default(false)
  /// Which admin verified this attorney, and when. "Verified" is a public claim
  /// that we checked their BASL registration; we must be able to say who did.
  /// Null on profiles verified before this was recorded (2026-10-16).
  /// A plain id, like `DataSubjectRequest.handledById`: a log, not a relation.
  verifiedById              String?
  verifiedAt                DateTime?
  /// Withdrawn by an admin (User Management → Revoke), with the reason the
  /// attorney is told. Verification is granted only through an application.
  verificationRevokedById   String?
  verificationRevokedAt     DateTime?
  verificationRevokedReason String?
  /// `Subscription` moved to `LawFirm` in Phase 3. An attorney does not buy a
  /// licence; the practice they work in does, and their access follows from
  /// their membership of it. Resolve through `src/lib/firms/billing.ts`.
  invoices                  Invoice[] @relation("InvoiceLawyer")

  /// The firm this attorney practises in (Phase 2).
  ///
  /// Never null in practice: every attorney belongs to a firm, and a solo
  /// practitioner is a firm of one created automatically on approval. It is
  /// modelled as optional only so that profile creation and firm creation do not
  /// have to happen in the same statement.
  firmId String?
  firm   LawFirm? @relation(fields: [firmId], references: [id], onDelete: SetNull)

  // Consultation & Booking relations
  availability          LawyerAvailability[]
  availabilityOverrides AvailabilityOverride[]
  consultationPricing   ConsultationPricing?
  bookings              Booking[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Law firms (Phase 2)
//
// The firm — not the platform, and not this software — is the provider of legal
// services. Every client-facing artefact must say so. We are the software the
// firm runs on. See docs/restructure/LEGAL-GUARDRAILS.md (rule 7).
//
// A solo practitioner is a firm of one, created automatically. A solo lawyer
// should never have to think about "firms" at all.
// ─────────────────────────────────────────────────────────────────────────────

/// How the practice is constituted.
///
/// Sri Lankan practice is understood to be as a sole practitioner or in
/// partnership; incorporation of legal practice is not permitted. That
/// understanding is unconfirmed — counsel question 8(a).
enum FirmType {
  SOLE_PRACTITIONER
  PARTNERSHIP
}

/// A member's role inside their firm. This is firm-internal authority and has
/// nothing to do with the platform `Role` enum or with subscription tiers.
///
/// PARALEGAL is deliberately the weakest: whether non-attorney staff may read
/// matter descriptions at all is counsel question 8(b), and until it is answered
/// they cannot. See src/lib/firms/access.ts — that file, not this comment, is
/// where the rule is enforced.
enum FirmRole {
  FIRM_OWNER // principal / partner; always an admitted attorney
  FIRM_ADMIN // practice manager; may or may not be an attorney
  ATTORNEY // admitted attorney practising in the firm
  PARALEGAL // non-attorney support staff
}

enum FirmMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED // soft delete; membership rows are never hard-deleted
}

/// Firm-level verification is a different thing from `LawyerProfile.isVerified`.
///
/// An attorney is verified against their BASL registration, individually. A firm
/// is verified as an existing practice at a real address whose named principal
/// is an admitted attorney. Both matter, and neither implies the other.
enum FirmVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model LawFirm {
  id   String @id @default(uuid())
  /// URL-safe identifier for the public firm page
  slug String @unique
  name String

  firmType FirmType @default(SOLE_PRACTITIONER)

  /// True when the firm exists only because a solo practitioner needed one.
  /// The UI hides firm management entirely for these until a second member is
  /// added, so a solo attorney's experience is unchanged.
  isSoloPractice Boolean @default(true)

  // --- Registration ---
  registrationNumber  String?
  /// The principal's BASL number, snapshotted for display. The authoritative
  /// value stays on the attorney's own LawyerProfile.
  principalBaslNumber String?
  establishedYear     Int?

  // --- Public profile. Bound by the Rule 40 content limit. ---
  // Permitted: name, qualifications, office hours, contact, and factual practice
  // information. NOT permitted here, ever: fee ranges or any price indication,
  // ratings or review counts, "featured"/"top"/"recommended" flags, or any
  // column whose value depends on what the firm pays us.
  // See docs/restructure/LEGAL-GUARDRAILS.md — "The Rule 40 content limit".
  description   String?
  practiceAreas String[]
  languages     String[]
  courts        String[]
  district      String?
  contactEmail  String?
  contactPhone  String?
  websiteUrl    String?
  /// Free text, e.g. "Mon–Fri 9.00am–5.00pm". Expressly permitted by Rule 40.
  officeHours   String?
  logoUrl       String?

  // --- Client account details ---
  // Recorded so quotes can be pre-filled with the firm's OWN bank details. The
  // platform never holds, routes, or verifies a payment into this account; it
  // only records that the firm said money arrived.
  // See docs/restructure/LEGAL-GUARDRAILS.md (rule 2).
  bankName      String?
  accountName   String?
  accountNumber String?
  bankBranch    String?

  // --- Tax identity ---
  // The firm's own, printed on the fee notes the firm issues to its own
  // clients. These are here because the firm is the supplier of the legal
  // service and therefore the taxable person; we are not in that transaction
  // at any point. See docs/restructure/LEGAL-GUARDRAILS.md (rules 1, 2 and 7).
  taxIdentificationNumber String?
  vatNumber               String?
  isVatRegistered         Boolean @default(false)
  /// Percent, e.g. 18 for 18%. Stored on the firm so a fee note can snapshot
  /// the rate that applied on the day it was issued.
  vatRatePercent          Int?

  // --- Verification ---
  verificationStatus FirmVerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  /// The ADMIN user who recorded the verification decision
  verifiedById       String?
  verificationNotes  String?

  /// True once a principal has actually registered this practice through the
  /// firm-registration flow, as opposed to it being the firm of one created
  /// automatically when their individual application was approved.
  ///
  /// The distinction matters for verification: an auto-created firm inherits the
  /// standing of its only member, and a registered practice must be checked in
  /// its own right before it appears in the public directory.
  isRegisteredPractice Boolean   @default(false)
  registeredAt         DateTime?

  /// Soft delete. Firms are never hard-deleted — matters reference them.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                 FirmMember[]
  offices                 FirmOffice[]
  lawyers                 LawyerProfile[]
  bookings                Booking[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  feeNotes                FeeNote[]
  conversations           Conversation[]
  invitations             FirmInvitation[]
  clientIntakeInvitations ClientIntakeInvitation[]

  subjectRequestResponses SubjectRequestFirmResponse[]

  @@index([verificationStatus])
  @@index([district])
  @@index([slug])
}

/// A firm's offices. A firm may practise from several, and each attorney keeps
/// their own calendar — availability is never collapsed to the firm.
model FirmOffice {
  id     String  @id @default(uuid())
  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  label        String // "Colombo (head office)"
  address      String
  district     String?
  contactPhone String?
  isPrimary    Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId, isActive])
}

/// Membership of a firm, with the member's firm-internal role.
model FirmMember {
  id     String  @id @default(uuid())
  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   FirmRole
  status FirmMemberStatus @default(ACTIVE)

  /// Job title as the firm words it. Display only — authority comes from `role`.
  title String?

  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime  @default(now())
  removedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([firmId, userId])
  @@index([firmId, status])
  @@index([userId, status])
}

enum FirmInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

/// An invitation to join a firm.
///
/// ───────────────────────────────────────────────────────────────────────────
/// WHY THIS MODEL EXISTS (Phase 7).
///
/// Before it, "adding a member" required the person to ALREADY have a platform
/// account, and adding them was instant and unilateral — the principal typed an
/// email address and that person was in the firm, able to see that its matters
/// exist, without ever being asked.
///
/// So a real multi-partner firm had no way to join. The only route was: one
/// partner registers as an individual attorney, a firm of one is silently
/// created and named after them, they rename it, and then they add partners one
/// at a time — each of whom must have registered separately first. Nobody would
/// guess that, and the last step put people inside a privilege boundary without
/// their consent.
///
/// An invitation fixes both halves: someone who has not registered can be
/// invited and will find the firm waiting when they do, and joining a practice
/// becomes something a person AGREES to rather than something done to them.
/// ───────────────────────────────────────────────────────────────────────────
model FirmInvitation {
  id     String  @id @default(uuid())
  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  /// Lower-cased. The invitee may not have an account yet, which is the point.
  email String
  role  FirmRole
  title String?

  /// Single-use secret in the invitation link. Unique so a lookup by token is
  /// an index hit and cannot be brute-forced by enumeration.
  token String @unique

  status FirmInvitationStatus @default(PENDING)

  invitedById      String
  /// A stale invitation is a standing offer of access to privileged material,
  /// so it expires whether or not anyone remembers to revoke it.
  expiresAt        DateTime
  respondedAt      DateTime?
  /// Set on acceptance. Null while the invitee has no account yet.
  acceptedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One outstanding invitation per email per firm. Re-inviting updates the
  /// existing row rather than leaving several live tokens for one person.
  @@unique([firmId, email])
  @@index([email, status])
  @@index([status, expiresAt])
}

/// A practice asking a client to confirm a request the practice opened for them.
///
/// ───────────────────────────────────────────────────────────────────────────
/// WHY THIS EXISTS (2026-10-13).
///
/// Clients reach a practice by phone, walk-in and referral, not only through the
/// directory, and the practice needs that matter in its queue. Before this the
/// only way was the admin "create booking" tool — platform staff choosing the
/// attorney (rule 4) and typing in the client's legal problem (rule 5).
///
/// Nothing is put in a client's account without the client agreeing. The practice
/// writes the request; the client signs in with the invited address and accepts;
/// only then does a `Booking` exist, at REQUESTED, so the conflict check still
/// runs. A practice cannot use this to put itself in front of a stranger: the
/// stranger simply never accepts, and the email says nothing about the matter.
///
/// `subject` and `description` are encrypted (ENCRYPTED_FIELDS) and WIPED the
/// moment the invitation stops being pending — accepted (the text now lives on
/// the Booking), declined, revoked or expired. A dead invitation keeps no copy of
/// anyone's legal problem.
/// ───────────────────────────────────────────────────────────────────────────
model ClientIntakeInvitation {
  id     String  @id @default(uuid())
  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  /// Lower-cased. The client may not have an account yet.
  email String

  /// Encrypted. Null once the invitation is no longer pending.
  subject      String?
  description  String?
  practiceArea String?
  mode         ConsultationMode

  /// The attorney the PRACTICE chose to handle it, if any. Becomes
  /// `Booking.lawyerId`; `clientSelectedAttorneyId` stays null — the client
  /// did not choose, the practice did.
  attorneyId String?

  /// Single-use secret in the link. The link is not a bearer token: accepting
  /// also requires signing in with `email`.
  token  String               @unique
  status FirmInvitationStatus @default(PENDING)

  invitedById String
  expiresAt   DateTime
  respondedAt DateTime?
  /// Set on acceptance.
  bookingId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId, status])
  @@index([email, status])
}

model SubscriptionPlan {
  id            String           @id @default(uuid())
  name          String
  tier          SubscriptionTier
  monthlyAmount Int
  yearlyAmount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions       Subscription[]
  subscriptionDetails SubscriptionDetails[]
  invoices            Invoice[]
}

/// A firm's licence to use this software.
///
/// The subscription belongs to the **firm**, not to an attorney. Before Phase 3
/// each attorney bought their own licence, which made the platform look like
/// something individual practitioners subscribe to in order to get work. What
/// we actually sell is practice-management software, and the practice is the
/// thing that runs on it.
///
/// It is priced on **seats and features** — how many people use the software
/// and what it can do — and never on how many matters, enquiries or clients
/// flow through it. Revenue that moves with the volume of legal work is
/// fee-sharing under a different name, whatever the invoice says. Phase 2.5
/// deleted enquiry and message quotas from the tiers for exactly this reason.
/// See docs/restructure/LEGAL-GUARDRAILS.md (rule 1).
model Subscription {
  id     String  @id @default(uuid())
  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  roleId String
  role   SubscriptionRole @relation(fields: [roleId], references: [id])

  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)

  startDate   DateTime  @default(now())
  endDate     DateTime?
  nextBilling DateTime

  autoRenew Boolean @default(true)

  invoiceId String?  @unique
  invoice   Invoice? @relation("SubscriptionInvoice", fields: [invoiceId], references: [id])

  cycles SubscriptionCycle[]
  usages FeatureUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId, status])
}

model SubscriptionCycle {
  id String @id @default(uuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  status SubscriptionStatus

  invoices Invoice[]
}

/// Our invoice to a firm for its software licence.
///
/// Do not confuse this with `FeeNote`. This is the platform billing a firm for
/// software. A `FeeNote` is a firm billing its own client for legal work, which
/// we only ever render as a document.
model Invoice {
  id String @id @default(uuid())

  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  /// The member who raised or paid it. Display and audit only — the firm is the
  /// party being billed, which is what `firmId` records.
  lawyerId String?
  lawyer   LawyerProfile? @relation("InvoiceLawyer", fields: [lawyerId], references: [id], onDelete: SetNull)

  subscriptionCycleId String?
  subscriptionCycle   SubscriptionCycle? @relation(fields: [subscriptionCycleId], references: [id], onDelete: SetNull)

  subscriptionId String?
  planId         String?
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id])

  amount          Int
  status          PaymentStatus @default(PENDING)
  paymentReason   String        @default("Subscription payment")
  receiptImageUrl String?
  paymentDetails  Json?
  adminNotes      String?

  remarks      InvoiceRemark[] @relation("InvoiceRemarks")
  subscription Subscription?   @relation("SubscriptionInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId, status])
}

model InvoiceRemark {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation("InvoiceRemarks", fields: [invoiceId], references: [id], onDelete: Cascade)

  remark      String
  isForLawyer Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum FeeNoteStatus {
  DRAFT
  ISSUED
  /// The firm has recorded that its client paid it. Not a payment we processed,
  /// observed, or verified — a fact the firm asserted.
  SETTLED
  CANCELLED
}

/// A firm's fee note to its own client.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// This is a **document we render**, not a transaction we run.
/// ─────────────────────────────────────────────────────────────────────────────
///
/// The firm supplies the legal service, so the firm is the taxable person and
/// the firm bills its client under its own TIN and VAT registration. The client
/// pays the firm's own bank account directly. We never hold the money, never
/// route it, never verify it, and take no percentage of it — that would be
/// unlicensed payment activity under the Payments and Settlements Systems Act
/// No. 28 of 2005 and fee-sharing under Supreme Court Rules 39-49 at the same
/// time. See docs/restructure/LEGAL-GUARDRAILS.md (rules 1, 2 and 7).
///
/// There is deliberately **no platform-fee column and no commission column** on
/// this model. Not a nullable one, not one defaulting to zero. A fee note is
/// arithmetic between a firm and its client that we are not part of.
///
/// Like the engagement letter, the rendered document is **snapshotted** rather
/// than joined at read time. A fee note is a tax document: if the firm later
/// changes its address, VAT number or name, an already-issued note must still
/// say what it said on the day it was issued.
model FeeNote {
  id String @id @default(uuid())

  /// Sequential per firm and year — "FN-2026-0001". Sri Lankan tax practice
  /// expects an unbroken series, so numbers are allocated on issue and a
  /// cancelled note keeps its number rather than freeing it for reuse.
  noteNumber String @unique

  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// The quote whose accepted terms this bills. A fee note that does not
  /// correspond to something the client agreed to is a dispute waiting to
  /// happen.
  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  // --- Snapshotted parties, as at issue ---
  firmName          String
  firmAddress       String?
  firmTin           String?
  firmVatNumber     String?
  firmBankName      String?
  firmAccountName   String?
  firmAccountNumber String?
  firmBankBranch    String?

  clientName    String
  clientAddress String?
  clientEmail   String?

  /// The attorney who did the work, named because the client is entitled to
  /// know who acted. The firm remains the party billing.
  attorneyName String?

  // --- Amounts, all in whole rupees ---
  /// [{ description, amount }] — narration comes from the accepted quote's
  /// scope, not from the client's account of their problem.
  lineItems      Json
  subtotal       Int
  /// Snapshotted from the firm at issue, because the rate can change.
  vatRatePercent Int?
  vatAmount      Int    @default(0)
  total          Int
  currency       String @default("LKR")

  status   FeeNoteStatus @default(DRAFT)
  issuedAt DateTime?
  dueDate  DateTime?

  /// When the FIRM recorded that its client paid. There is no admin approval
  /// step and no platform confirmation, by design.
  settledAt        DateTime?
  settlementNote   String?
  cancelledAt      DateTime?
  cancellationNote String?

  /// The rendered note, frozen at issue. Markdown.
  content String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId, status])
  @@index([bookingId])
}

model SubscriptionDetails {
  id             String           @id @default(uuid())
  subscriptionId String
  subscription   SubscriptionPlan @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  details        String
}

// The `Inquiry` model was removed in Phase 7.
//
// It was an UNAUTHENTICATED intake: `POST /api/inquiries` accepted a person's
// name, phone number, email and a free-text description of their legal problem,
// addressed to a named attorney, with no sign-in, no rate limit, no firm
// scoping, no privilege gate and no retention. It sat outside every access
// control in the system and predated firm-first intake, which is its proper
// replacement — that path runs the conflict check, the quote and the engagement
// letter, and puts the material behind src/lib/firms/access.ts.
//
// Two intakes doing the same job is the duplicate-state-machine problem this
// restructure has fixed twice already. The rows were deleted rather than
// migrated: an enquiry created no retainer and no obligation, so there was no
// lawful basis to keep holding a stranger's account of their legal problem.
//
// See docs/restructure/DATA-INVENTORY.md §7 finding A.

// The `Article` model was removed on 2026-10-14. It was the first version of
// the blog, lawyers only, and was replaced by community posts (`Post`); it had
// no editor, nothing wrote to it, and the table was empty.

// The `Review` model was removed in Phase 2.
//
// Star ratings of attorneys are "unfair attraction" under Supreme Court Rule 39,
// and any rating signal makes directory ordering non-neutral under guardrail
// rule 4. The UI had been removed in an earlier commit but the model, the
// endpoint and the public payloads were all still live.
// See docs/restructure/LEGAL-GUARDRAILS.md — "The Rule 40 content limit".

// PromoStatus removed in Phase 4 along with the PaidPromo model. See below.

enum PaymentStatus {
  PAID
  UNPAID
  PENDING
  RESUBMIT
  CANCELLED
}

// The `PaidPromo` model was removed in Phase 4.
//
// It sold a promotional slot to a LawyerProfile. That is selling visibility to
// an attorney: prohibited by guardrail rule 3, prohibited as advertising under
// Supreme Court Rules 39-49, and — because it reaches the intermediary —
// exposure for this platform's operators under the Intermeddlers with Suitors
// Ordinance No. 11 of 1894.
//
// It is not repurposed or renamed. Advertising is now sold to non-legal
// advertisers only, through the `Advertiser` model.
// See docs/restructure/LEGAL-GUARDRAILS.md (rule 3).

// ============= Advertisement Management System =============
//
// Advertising is sold to NON-LEGAL advertisers only.
//
// An attorney may not advertise or solicit, so selling an attorney visibility
// makes this platform the mechanism of their breach — and touting reaches the
// intermediary as a criminal matter under the Intermeddlers with Suitors
// Ordinance No. 11 of 1894. A bank, an insurer or a university is under no such
// restriction, so their advertising raises no touting question at all.
//
// The rule is enforced structurally: `AdCampaign` belongs to an `Advertiser`,
// and there is no relation from `AdCampaign` to `LawyerProfile` or `LawFirm`.
// A lawyer cannot buy an advert because there is nowhere to put them.
// See docs/restructure/LEGAL-GUARDRAILS.md (rule 3).

/// What sector an advertiser trades in.
///
/// There is deliberately no legal-services category, and there never may be.
/// The categories that are refused outright are listed in
/// src/lib/ads/eligibility.ts — the schema cannot express "not a law firm", so
/// the check lives in code and in the admin review step.
enum AdvertiserCategory {
  BANKING_FINANCE
  INSURANCE
  EDUCATION
  PUBLISHING_MEDIA
  TECHNOLOGY
  HEALTHCARE
  REAL_ESTATE
  GOVERNMENT_NGO
  RETAIL_CONSUMER
  PROFESSIONAL_SERVICES // accountancy, translation, surveying — never legal
  OTHER
}

enum AdvertiserStatus {
  PENDING_REVIEW // submitted, not yet checked
  ACTIVE
  SUSPENDED
  REJECTED
}

/// A non-legal organisation that buys advertising space.
model Advertiser {
  id   String @id @default(uuid())
  name String

  /// Registered legal name and company registration, so the review step can
  /// establish who this actually is before any advert runs.
  legalName          String?
  registrationNumber String?

  category AdvertiserCategory
  status   AdvertiserStatus   @default(PENDING_REVIEW)

  contactName  String?
  contactEmail String
  contactPhone String?
  websiteUrl   String?
  logoUrl      String?

  /// Recorded by the ADMIN who confirmed this advertiser neither practises law
  /// nor sells legal services. An advertiser cannot run a campaign without it.
  /// This is the check that keeps rule 3 intact, so it is a stored fact with a
  /// name and a date against it, not an implicit consequence of `status`.
  nonLegalConfirmed     Boolean   @default(false)
  nonLegalConfirmedAt   DateTime?
  nonLegalConfirmedById String?
  reviewNotes           String?

  isActive Boolean @default(true)

  campaigns AdCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

enum AdType {
  BANNER_IMAGE // Full banner with image (for hero, top areas)
  PROFILE_CARD // Lawyer profile card format
  SIDEBAR_CARD // Compact card for sidebars
  STICKY_BAR // Thin sticky bottom bar
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

enum AdPauseActor {
  ADMIN
  LAWYER
}

enum AdPlacement {
  HOMEPAGE_BELOW_HERO // Homepage: below hero, above "Legal Advisory" section
  CHAT_RIGHT_SIDEBAR // /en/chat: right sidebar
  BLOG_TOP_BANNER // /en/blog: above category cards
  BLOG_RIGHT_SIDEBAR // /en/blog: right sidebar sticky
  BLOG_BOTTOM_STICKY // /en/blog: bottom fixed bar
  BLOG_POST_SIDEBAR // /en/blog/[slug]: right sidebar
  BLOG_POST_BOTTOM // /en/blog/[slug]: below article content
  LEGAL_LIBRARY_SIDEBAR // /en/legal-library: right sidebar
  // DIRECTORY_TOP and DIRECTORY_INLINE were removed in Phase 4.
  //
  // They sold position at the top of, and inside, the attorney directory. Even
  // with a non-legal advertiser that is wrong: an advert inside a results list
  // teaches a client that position in that list is purchasable, and blurs the
  // line between a listing and an advertisement.
  //
  // Deleted from the enum rather than merely deactivated, so that re-enabling
  // them requires a migration and a conversation, not a toggle in an admin
  // screen. Advertising belongs on editorial surfaces only.
  // See docs/restructure/LEGAL-GUARDRAILS.md (rules 3 and 4).
}

// Admin-configurable settings per ad placement
model AdPlacementConfig {
  id String @id @default(uuid())

  placement   AdPlacement @unique // One config per placement
  displayName String // Human-readable name
  description String? // Where this placement appears

  // Pricing (in LKR)
  pricePerDay Int // Price per day

  // Slider configuration
  isSlider       Boolean @default(false)
  sliderInterval Int     @default(3000) // ms between slides
  maxAdsPerSlot  Int     @default(3) // Max ads shown at once

  // Dimensions guidance
  recommendedWidth  Int? // px
  recommendedHeight Int? // px

  // Active/Inactive toggle
  isActive Boolean @default(true)

  // Ad types allowed for this placement
  allowedAdTypes AdType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdCampaign {
  id String @id @default(uuid())

  // Who owns this campaign.
  //
  // An Advertiser, never a LawyerProfile or a LawFirm. There is no relation to
  // either, on purpose: a lawyer cannot buy an advert because the schema gives
  // them nowhere to be. See docs/restructure/LEGAL-GUARDRAILS.md (rule 3).
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  // Campaign details
  name      String
  type      AdType
  placement AdPlacement
  status    AdStatus    @default(DRAFT)

  // Creative assets
  title       String?
  description String?
  imageUrl    String?
  targetUrl   String?
  ctaText     String? @default("Learn more")

  // Targeting.
  //
  // These describe the PAGE an advert may appear on, never the person reading
  // it. Nothing here may ever be derived from what a client wrote about their
  // legal problem — that is privileged material, and using it to sell adverts
  // would breach rule 5 and the PDPA at once.
  // See docs/restructure/LEGAL-GUARDRAILS.md (rule 5).
  targetDistricts     String[]
  targetPracticeAreas String[]

  // Schedule
  startDate DateTime
  endDate   DateTime

  // Budget & Pricing (in LKR)
  totalBudget Int?
  dailyBudget Int?
  pricePerDay Int?

  // Performance metrics (denormalized for speed)
  impressions Int @default(0)
  clicks      Int @default(0)

  // Admin
  adminNotes      String?
  rejectionReason String?
  pausedBy        AdPauseActor?

  // Billing
  invoiceId String?

  // Relations
  bookings  AdSlotBooking[]
  analytics AdAnalytics[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Track booked dates per placement for availability checking
model AdSlotBooking {
  id         String      @id @default(uuid())
  campaignId String
  campaign   AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement  AdPlacement
  date       DateTime    @db.Date

  createdAt DateTime @default(now())

  @@unique([placement, date, campaignId])
  @@index([placement, date])
}

model AdAnalytics {
  id         String     @id @default(uuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([campaignId, date])
}

// ============= Subscription RBAC System =============

model SubscriptionRole {
  id          String           @id @default(uuid())
  name        SubscriptionTier
  description String?

  permissions   SubscriptionRolePermission[]
  subscriptions Subscription[]
  featureLimits FeatureLimitConfig[]         @relation(name: "RoleFeatureLimits")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "access_chat", "upload_documents"
  slug        String  @unique // URL-friendly version
  description String?
  category    String // e.g., "chat", "profile"

  roles SubscriptionRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionRolePermission {
  id     String           @id @default(uuid())
  roleId String
  role   SubscriptionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model Feature {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "firm_seats", "document_templates"
  slug        String  @unique
  description String?
  unit        String // e.g., "count", "GB", "hours"

  usages FeatureUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureLimitConfig {
  id     String           @id @default(uuid())
  roleId String
  role   SubscriptionRole @relation(name: "RoleFeatureLimits", fields: [roleId], references: [id], onDelete: Cascade)

  featureName String // e.g., "firm_seats", "document_templates"
  limit       Int // e.g., 10, 50, unlimited if -1
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, featureName])
}

model FeatureUsage {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id])

  usage Int @default(0)

  // For monthly/yearly reset tracking
  billingCycleStart DateTime
  billingCycleEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, featureId, billingCycleStart])
}

// ============= Chat System =============

/// A message thread between a client and a firm.
///
/// ───────────────────────────────────────────────────────────────────────────
/// This is privileged material (Evidence Ordinance s.126) and until Phase 7 it
/// was the one place holding privileged material that never passed through
/// `src/lib/firms/access.ts`. It had no firm, no matter, and no rule beyond
/// "are you a row in ConversationParticipant" — which meant an attorney who
/// left a practice kept reading its clients' messages forever, and nothing in
/// the schema said platform staff must not.
///
/// `firmId` and `clientId` exist so the rule can be expressed at all. Access is
/// decided by `resolveConversationAccess()`, asserted by `npm run check:privilege`.
/// See docs/restructure/DATA-INVENTORY.md §7 finding B.
/// ───────────────────────────────────────────────────────────────────────────
model Conversation {
  id String @id @default(uuid())

  /// The firm on the other side of the thread. The client talks to a practice,
  /// not to an individual who might leave it. NULL only for threads created
  /// before Phase 7 whose attorney had no firm at backfill time — those fall
  /// back to participants-only access and can never be widened.
  firmId String?
  firm   LawFirm? @relation(fields: [firmId], references: [id], onDelete: SetNull)

  /// The client in the thread, denormalised so access does not depend on
  /// scanning participants and guessing which one is the client by role.
  clientId String?
  client   User?   @relation("ClientConversations", fields: [clientId], references: [id], onDelete: SetNull)

  /// The matter this thread concerns, where it concerns one. Optional because a
  /// client may message a firm before any matter exists — which is exactly the
  /// moment the material is most sensitive and least protected.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([firmId, updatedAt])
  @@index([clientId, updatedAt])
  @@index([bookingId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  /// Encrypted at rest, bound to this message id. Never read directly — go
  /// through `discloseMessage()` in src/lib/firms/access.ts, which will not
  /// hand back ciphertext to a reader who may not have the words.
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ============= Community & Knowledge Hub =============

model Community {
  id          String          @id @default(uuid())
  name        String          @unique
  displayName String
  description String
  rules       String?
  icon        String?
  coverImage  String?
  category    String
  status      CommunityStatus @default(ACTIVE)

  createdById String
  createdBy   User   @relation("CommunityCreator", fields: [createdById], references: [id])

  members CommunityMember[]
  posts   Post[]

  postCount   Int @default(0)
  memberCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityMember {
  id          String     @id @default(uuid())
  communityId String
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([communityId, userId])
}

model CommunityRequest {
  id          String                 @id @default(uuid())
  requesterId String
  requester   User                   @relation("CommunityRequester", fields: [requesterId], references: [id])
  name        String
  displayName String
  description String
  category    String
  reason      String
  status      CommunityRequestStatus @default(PENDING)
  adminNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title      String
  slug       String   @unique
  content    String
  excerpt    String?
  coverImage String?
  images     String[]
  language   String   @default("en")

  status         PostStatus @default(PENDING_REVIEW)
  /// Who took a REMOVED post down: AUTHOR, MODERATOR, or AUTO_REPORTS (hidden at
  /// three pending reports). Dismissing a report restores only an AUTO_REPORTS
  /// removal — it used to republish a post its author or a moderator had removed.
  removedBy      String?
  /// The moderator's reason when a post is rejected or removed; shown to the
  /// author in My Posts (2026-10-16).
  moderationNote String?
  isPinned       Boolean    @default(false)
  isLocked       Boolean    @default(false)
  isAnonymous    Boolean    @default(false)

  upvotes      Int @default(0)
  downvotes    Int @default(0)
  score        Int @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)

  votes        Vote[]            @relation("PostVotes")
  comments     Comment[]
  reports      Report[]          @relation("PostReports")
  translations PostTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostTranslation {
  id      String  @id @default(uuid())
  postId  String
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale  String
  title   String
  content String
  excerpt String?
  isAuto  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, locale])
}

model Comment {
  id       String    @id @default(uuid())
  postId   String
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  content     String
  language    String  @default("en")
  isDeleted   Boolean @default(false)
  isAnonymous Boolean @default(false)

  upvotes   Int @default(0)
  downvotes Int @default(0)
  score     Int @default(0)

  votes        Vote[]               @relation("CommentVotes")
  reports      Report[]             @relation("CommentReports")
  translations CommentTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommentTranslation {
  id        String  @id @default(uuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  locale    String
  content   String
  isAuto    Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([commentId, locale])
}

model Vote {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)
  type   VoteType

  postId    String?
  post      Post?    @relation("PostVotes", fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation("CommentVotes", fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation("UserReports", fields: [reporterId], references: [id])
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  adminNotes  String?

  postId    String?
  post      Post?    @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation("CommentReports", fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= Legal Document Management System =============

// What kind of document it is. "Amendment" is not a kind: an amending Act is an
// ACT whose amendsId points at the law it changes. Labels: src/lib/legalLibrary.ts
enum LegalDocumentCategory {
  CONSTITUTION
  ACT
  ORDINANCE
  REGULATION
  PROVINCIAL_STATUTE
  GAZETTE_NOTIFICATIONS
  COURT_RULES
  SRI_LANKA_LAW_REPORTS
  SUPREME_COURT_DECISIONS
  COURT_OF_APPEAL_DECISIONS
  HIGH_COURT_DECISIONS
}

// What a document is about, for people who think "I have a land problem".
enum LegalSubject {
  CONSTITUTIONAL
  CRIMINAL
  CIVIL_PROCEDURE
  FAMILY
  LAND_PROPERTY
  LABOUR
  BUSINESS
  TAX_FINANCE
  CONSUMER
  MOTOR_TRAFFIC
  ENVIRONMENT
  ADMINISTRATIVE
}

enum LegalDocumentStatus {
  PROCESSING
  ACTIVE
  FAILED
  ARCHIVED
  // A law listed without its original text yet: Parliament has its amending
  // Acts, but the law itself predates Parliament (the Penal Code, 1883). Shown in
  // the library as "Original text: being added". Never ACTIVE: the AI does not
  // hold it, and everything that speaks for the AI reads ACTIVE only.
  AWAITING_ORIGINAL
}

model LegalDocument {
  id          String                @id @default(uuid())
  title       String
  category    LegalDocumentCategory
  description String?

  // Sri Lanka specific metadata
  actNumber          String?
  year               Int? // the year it was enacted or decided
  // A consolidated text includes every amendment up to this year (the 1980
  // Revised Edition: 1980). Null for a text as enacted.
  consolidatedToYear Int?
  courtName          String?
  caseNumber         String?
  gazetteNumber      String?
  subjects           LegalSubject[] @default([])

  // An amending Act points at the law it changes; that law lists it.
  amendsId   String?
  amends     LegalDocument?  @relation("Amendments", fields: [amendsId], references: [id], onDelete: SetNull)
  amendments LegalDocument[] @relation("Amendments")

  // Where the text came from, so a reader can check it: "Parliament of Sri Lanka"
  // and the PDF's address there. Null when not recorded (older uploads).
  sourceName    String?
  sourceUrl     String?
  // When someone last confirmed nothing newer exists. The Parliament check sets
  // it on every law it found no pending amendment for.
  lastCheckedAt DateTime?

  parliamentAct ParliamentAct?

  // File info
  fileName  String
  fileSize  Int // bytes
  pageCount Int?

  // RAG metadata
  ragDocumentName    String? // Name in ChromaDB
  chunksCount        Int     @default(0)
  graphEntities      Int     @default(0)
  graphRelationships Int     @default(0)

  // AI-generated document outline (JSON array of section summaries)
  outline Json?

  // Status
  status       LegalDocumentStatus @default(PROCESSING)
  errorMessage String?

  // Admin tracking
  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([year])
  @@index([amendsId])
}

// Acts seen on Parliament's Acts listing (parliament.lk), waiting for an admin.
// Nothing reaches the library or the AI until an admin approves it.
enum ParliamentActStatus {
  NEW
  IMPORTED
  DISMISSED
}

model ParliamentAct {
  id                String              @id @default(uuid())
  // Parliament's own id, "G6435" in .../act-details/G6435
  ref               String              @unique
  actNumber         String? // "23/2026"; null for a constitutional amendment
  year              Int?
  title             String // as Parliament prints it: "JUDICATURE (AMENDMENT)"
  endorsedOn        DateTime?
  pdfUrl            String
  detailUrl         String
  isAmendment       Boolean
  // The library law its title names, when one was found: a suggestion the admin
  // confirms or changes.
  suggestedAmendsId String?
  status            ParliamentActStatus @default(NEW)

  legalDocumentId String?        @unique
  legalDocument   LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: SetNull)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?

  @@index([status])
  @@index([year])
}

// ============= AI Chat System =============

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("New Chat")
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'user' or 'assistant'
  content        String

  // Citations that survived src/lib/ai/policy.ts — each one names a document
  // that was actually retrieved. Never client-supplied.
  citations Json?

  // Set when the assistant declined to answer, or when a generated answer was
  // withheld. Values are RefusalCategory in src/lib/ai/policy.ts. Kept because a
  // rising count in one category is a signal about the model or the corpus, and
  // because "we refused" is the fact we would need to evidence.
  refusalCategory String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ============= Consultation & Booking System =============

// Lawyer's recurring weekly availability (e.g., "Every Monday 9AM-5PM")
model LawyerAvailability {
  id       String        @id @default(uuid())
  lawyerId String
  lawyer   LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  dayOfWeek    DayOfWeek
  startTime    String // "09:00" (HH:mm 24hr, SLST)
  endTime      String // "17:00"
  slotDuration Int              @default(60) // minutes per slot
  bufferTime   Int              @default(15) // minutes gap between slots
  mode         ConsultationMode @default(BOTH)
  isActive     Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lawyerId, dayOfWeek, startTime])
}

// Date-specific overrides (e.g., "May 10th available 2PM-4PM only" or blocked)
model AvailabilityOverride {
  id       String        @id @default(uuid())
  lawyerId String
  lawyer   LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  isBlocked Boolean  @default(false)
  startTime String? // null if blocked
  endTime   String? // null if blocked
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lawyerId, date])
}

// Lawyer's consultation pricing configuration
model ConsultationPricing {
  id       String        @id @default(uuid())
  lawyerId String        @unique
  lawyer   LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  pricingType ConsultationPricingType @default(PER_SESSION)
  currency    String                  @default("LKR")

  // `physicalPrice` and `onlinePrice` were dropped in Phase 3.
  //
  // They were the last remnant of the marketplace: a published price a client
  // could see and "buy" a consultation at. Since Phase 1 a fee has existed only
  // on a Quote, issued by the attorney after a conflict check, for that matter.
  // Both columns had been forced to 0 since Phase 0 and were read by nothing —
  // but a price column on a lawyer's profile is one product decision away from
  // being a fee range on a public page, which Rule 40 does not permit.

  freeInitialConsultation  Boolean @default(false)
  freeConsultationDuration Int? // minutes
  minAdvanceNoticeHours    Int     @default(24) // minimum hours before booking

  bankName      String?
  accountName   String?
  accountNumber String?
  bankBranch    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Core booking record
model Booking {
  id            String @id @default(uuid())
  bookingNumber String @unique // "BK-2026-0001"

  clientId String
  client   User   @relation("ClientBookings", fields: [clientId], references: [id])

  /// The attorney currently responsible for this matter.
  ///
  /// NULL means the request is sitting in the firm's queue, not yet assigned —
  /// which is what happens when a client engages the FIRM rather than picking an
  /// individual. A firm owner or firm admin assigns it, and may reassign it
  /// later, but only ever to an attorney **in the same firm**; nothing can move
  /// a matter between firms.
  lawyerId String?
  lawyer   LawyerProfile? @relation(fields: [lawyerId], references: [id])

  /// The attorney the client themselves chose at intake, if they chose one.
  ///
  /// Set once and never changed — including when the firm reassigns the matter.
  /// This is the evidence that the choice of practitioner was the client's and
  /// never the platform's, which is the whole of guardrail rule 4. NULL means
  /// the client engaged the firm and left the choice of attorney to it.
  clientSelectedAttorneyId String?

  /// The firm that received the request and is the provider of legal services.
  ///
  /// Required: a matter always belongs to a firm, even when no individual
  /// attorney has been assigned yet. Immutable after intake.
  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id])

  /// Set when a firm owner/admin reassigns the responsible attorney. Null on a
  /// matter that has stayed with the attorney the client originally chose.
  assignedById   String?
  assignedAt     DateTime?
  assignmentNote String?

  // Schedule.
  //
  // NULL until an appointment exists. A client who engages a firm does not pick
  // a slot at intake — the firm has not yet decided whether it can act, and
  // holding a diary slot before a conflict check is a marketplace-booking habit,
  // not how an engagement works. The attorney proposes a time with the quote.
  //
  // The attorney-first path still sets these at intake, because there the client
  // picked a specific practitioner and one of their published slots.
  date      DateTime? @db.Date
  startTime String? // "10:00"
  endTime   String? // "11:00"
  duration  Int? // minutes

  // Mode
  mode          ConsultationMode
  meetingLink   String? // Google Meet URL
  officeAddress String? // For PHYSICAL

  // Fee snapshot at the time terms were agreed.
  // The platform derives nothing from this and receives none of it — the client
  // pays the firm directly. There is deliberately no commission field.
  // See docs/restructure/LEGAL-GUARDRAILS.md (rule 1).
  lawyerFee   Int // The firm's fee (LKR, whole rupees)
  totalAmount Int // What the client pays — equal to lawyerFee

  // Client's issue
  subject      String
  description  String
  practiceArea String?

  // Status
  status BookingStatus @default(REQUESTED)

  // Phase 1 engagement flow
  conflictCheck    ConflictCheck?
  quotes           Quote[]
  engagementLetter EngagementLetter?
  feeNotes         FeeNote[]
  conversations    Conversation[]
  /// Set when the client accepts a quote — the moment terms are agreed
  termsAcceptedAt  DateTime?

  // Payment
  paymentMethod       BookingPaymentMethod?
  paymentInstructions String?
  payment             BookingPayment?
  paidAt              DateTime?

  // Post-consultation
  lawyerNotes String?

  // `clientRating` and `clientFeedback` were dropped in Phase 6.
  //
  // Phase 2 deleted the `Review` model and reported that ratings were gone
  // entirely. They were not: the `rate` action still wrote a 1-5 score here and
  // the lawyer console still rendered it as stars. No UI collected it any more,
  // so it was a dormant column with a live write path — and a column that
  // exists is a column a future product decision can populate. `clientRating`
  // was one `orderBy` away from being ranking, which is guardrail rules 3 and 4.
  // Removed rather than disabled, exactly like the commission columns.
  // See docs/restructure/LEGAL-GUARDRAILS.md and DATA-INVENTORY.md finding E.

  // Lawyer workflow
  lawyerRemarks          String?
  rescheduleProposedDate DateTime?
  rescheduleProposedTime String?
  adminRemarks           String?

  // Cancellation
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?
  refundAmount      Int?
  retainedLawyerFee Int?
  refundStatus      RefundStatus @default(NONE)
  refundProcessedAt DateTime?
  refundNotes       String?

  // Evidence that the refund was actually made. A note alone is the firm's
  // unsupported word; these make the record checkable by the client.
  refundMethod    String? // e.g. "Bank transfer", "Cash", "Cheque"
  refundReference String? // transaction reference from the firm's bank
  refundProofUrl  String? // uploaded receipt or transfer confirmation
  refundSentOn    String? // the date the firm actually sent it (yyyy-MM-dd)

  // The client's side of the record.
  refundConfirmedAt   DateTime?
  refundDisputedAt    DateTime?
  refundDisputeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([lawyerId, date])
  @@index([firmId, status])
  /// The firm's unassigned queue
  @@index([firmId, lawyerId])
  @@index([status])
  @@index([bookingNumber])
}

/// Conflict-of-interest screening, run by the firm before accepting a client.
///
/// This is a professional duty, not a nicety: a firm must not act where it holds
/// a conflicting interest. Recording it here gives the firm an auditable trail.
///
/// PRIVILEGED AND FIRM-INTERNAL. `notes` and `screenedParties` must never be
/// exposed to the client or to platform staff.
/// See docs/restructure/LEGAL-GUARDRAILS.md (rule 5).
model ConflictCheck {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  outcome         ConflictCheckOutcome
  /// Names screened against existing/former clients and opposing parties
  screenedParties String[]
  /// Firm-internal reasoning. Never leaves the firm.
  notes           String?

  /// The attorney or firm admin who ran the check. Never platform staff.
  checkedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outcome])
}

/// A fee quote issued by the firm to the client.
///
/// The amount is the FIRM's fee in full. The platform derives nothing from it and
/// receives none of it — the client pays the firm directly using
/// `paymentInstructions`. See docs/restructure/LEGAL-GUARDRAILS.md (rules 1, 2, 7).
///
/// Versioned so a firm can re-quote (e.g. after the client asks for a narrower
/// scope) without destroying the history of what was previously offered.
model Quote {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  version Int         @default(1)
  status  QuoteStatus @default(SENT)

  feeBasis       FeeBasis
  /// LKR, whole rupees (never cents — see the PayHere bug removed in Phase 0.3)
  amount         Int
  currency       String   @default("LKR")
  hourlyRate     Int?
  estimatedHours Float?

  /// What the fee covers, and what it does not. Both shown to the client.
  scopeOfWork String
  exclusions  String?

  /// The firm's own bank details. The platform records these; it never collects.
  paymentInstructions String

  validUntil DateTime

  /// The appointment the attorney proposes, for a matter that has no slot yet
  /// (the firm-first path). Applied to the Booking when the client accepts.
  /// NULL where the client already chose a slot at intake.
  proposedDate      DateTime? @db.Date
  proposedStartTime String?
  proposedEndTime   String?

  /// The attorney who issued the quote
  issuedById    String
  respondedAt   DateTime?
  declineReason String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  engagementLetter EngagementLetter?
  feeNotes         FeeNote[]

  @@unique([bookingId, version])
  @@index([bookingId, status])
  @@index([status, validUntil])
}

/// The engagement letter issued when a client accepts a quote.
///
/// This is the artefact that makes the relationship legally clean: it records who
/// is engaged, on what scope, on what fee basis, and states explicitly that the
/// FIRM provides the legal service while this platform is only the software the
/// firm runs on. Valid as an electronic record under the Electronic Transactions
/// Act No. 19 of 2006.
///
/// Content is snapshotted at issue time rather than joined at read time, so the
/// letter always reflects the terms as they were agreed even if the firm's
/// profile or the quote changes later.
///
/// See docs/restructure/LEGAL-GUARDRAILS.md (rule 7).
model EngagementLetter {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id])

  /// Human-readable reference, e.g. "EL-2026-0001"
  reference String @unique

  // --- Snapshot of the parties at the time of engagement ---
  firmName       String
  firmBaslNumber String
  firmAddress    String?
  firmContact    String?
  clientName     String
  clientEmail    String

  // --- Snapshot of the agreed terms ---
  matterSubject String
  scopeOfWork   String
  exclusions    String?
  feeBasis      FeeBasis
  feeAmount     Int
  currency      String   @default("LKR")
  paymentTerms  String

  /// Full rendered letter body (Markdown), generated at issue time
  body String

  issuedAt       DateTime  @default(now())
  /// When the client viewed it — useful evidence that terms were communicated
  clientViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
}

// Temporary hold on a slot during checkout
model SlotHold {
  id        String   @id @default(uuid())
  clientId  String
  lawyerId  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([lawyerId, date])
  @@index([expiresAt])
}

// Payment record linked to a booking
model BookingPayment {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount Int
  method BookingPaymentMethod @default(BANK_TRANSFER)
  status PaymentStatus        @default(PENDING)

  // Bank transfer fields
  bankName        String?
  accountHolder   String?
  accountNumber   String?
  transactionDate String?
  transactionRef  String?
  receiptImageUrl String?
  notes           String?

  // Admin verification
  verifiedBy String?
  verifiedAt DateTime?
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// WithdrawRequest / WithdrawStatus removed in Phase 1a.
// The platform never holds a lawyer's fees, so there is no balance to withdraw
// from. See docs/restructure/LEGAL-GUARDRAILS.md (rule 2).

// ============= Data protection (PDPA No. 9 of 2022) — Phase 6 =============
//
// Three models and one status field, all serving one rule file:
// src/lib/privacy/policy.ts. See docs/restructure/DATA-INVENTORY.md for what
// personal data this platform holds and under which lawful basis.

/// Lifecycle of a user account.
///
/// The project convention is soft delete via status fields and no hard deletes
/// (see AGENTS.md), but `User` had nothing to soft-delete WITH — so an erasure
/// request had no landing place. A hard delete is not available to us: matters
/// reference clients for years and a firm may be professionally required to
/// keep the file, so removing the row would either cascade into a firm's
/// records or orphan them.
enum UserStatus {
  ACTIVE
  /// Signed out and blocked from signing in, at the user's request. Reversible.
  DEACTIVATED
  /// Identifying fields have been overwritten in place. Irreversible.
  /// The row survives so that a firm's matter file stays referentially intact.
  ERASED
}

/// Purposes for which we rely on CONSENT — and only these.
///
/// Matter data is processed to perform the retainer and to meet the firm's
/// professional duties. It is deliberately absent from this enum: asking for
/// consent implies it can be withdrawn, and we cannot honour a withdrawal
/// against a firm's retention duty. Calling everything consent is the common
/// and expensive PDPA error.
enum ConsentPurpose {
  /// Product news and offers by email. Never a precondition of using anything.
  MARKETING_EMAIL
  /// Non-essential usage analytics.
  PRODUCT_ANALYTICS
  /// Keeping AI chat history so the user can return to it. Withdrawing this
  /// purges their conversations rather than merely stopping collection.
  AI_HISTORY_RETENTION
}

/// A record that a person agreed to — or withdrew from — a specific purpose.
///
/// Consent under the PDPA must be specific, informed and demonstrable, so this
/// records the purpose, the version of the notice shown, and the moment. A row
/// is never updated in place: withdrawing writes `withdrawnAt` and granting
/// again writes a NEW row, because the history is the evidence.
model ConsentRecord {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose ConsentPurpose

  /// The version of the privacy notice the person was shown. Without this,
  /// "they consented" is a claim about a document nobody can produce.
  noticeVersion String

  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  /// Where the agreement was given, for evidence. Not used for tracking.
  sourceIp  String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, purpose, withdrawnAt])
}

/// The lifecycle of a privacy-notice version.
///
/// There is no `ARCHIVED`/`DELETED` state and there must never be one. A
/// published version is evidence of what a person was shown, and evidence that
/// can be taken off the shelf is not evidence.
enum PrivacyNoticeStatus {
  /// Being written. Not visible to anyone but an administrator, and the only
  /// state in which the text may be edited.
  DRAFT
  /// The version currently in force. At most one row is ever in this state.
  PUBLISHED
  /// Was in force; replaced by a later version. Still readable at its own URL,
  /// forever, because consent records point at it.
  SUPERSEDED
}

/// A published version of the privacy notice.
///
/// ───────────────────────────────────────────────────────────────────────────
/// WHY THIS IS VERSIONED RATHER THAN A ROW SOMEBODY EDITS.
///
/// `ConsentRecord.noticeVersion` records which notice a person was shown when
/// they agreed. Consent under the PDPA must be **demonstrable**, which means
/// producing the exact words — so if an administrator edited the notice in
/// place, every past consent record would silently start pointing at wording
/// that person never saw, and the evidence would be destroyed by an ordinary
/// content edit with no error anywhere.
///
/// So publishing writes a NEW row and supersedes the old one. Nothing updates
/// the `body` of a PUBLISHED or SUPERSEDED version; `assertEditable()` in
/// `src/lib/privacy/notice.ts` refuses it and `npm run check:pdpa` asserts it.
///
/// This is the same snapshot rule already used for `EngagementLetter.body` and
/// `FeeNote.content`, for the same reason: a document that says what a person
/// agreed to has to keep saying it after the business changes its mind.
/// ───────────────────────────────────────────────────────────────────────────
model PrivacyNotice {
  id String @id @default(uuid())

  /// The label consent records point at, e.g. `2026-08-03`. Unique, and never
  /// reused: a dangling reference is not repaired by relabelling the target.
  version String @unique

  title String @default("Privacy Notice")

  /// Markdown. The whole notice, self-contained — never assembled at read time
  /// from fragments that can drift.
  body String

  /// What changed since the previous version, in plain language. Shown at the
  /// top of a superseded version so a reader can see why they are looking at it.
  changeSummary String?

  status PrivacyNoticeStatus @default(DRAFT)

  publishedAt   DateTime?
  /// Who published it. Not a relation to `User`: this must survive the erasure
  /// of that administrator's account, exactly like `DataAccessLog.actorUserId`.
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

/// What kind of record an access-log entry refers to.
enum AuditedResource {
  BOOKING
  CONFLICT_CHECK
  QUOTE
  ENGAGEMENT_LETTER
  FEE_NOTE
  MESSAGE_THREAD
  SUBJECT_REQUEST
}

/// What was done to it.
enum AuditedAction {
  /// Saw that the matter exists — list entry, status, schedule.
  READ_SUMMARY
  /// Read the client's own account of their problem, notes, or conflict check.
  READ_DETAIL
  EXPORTED
  RECTIFIED
  ERASED
}

/// Who read what matter data, and when.
///
/// `firms/access.ts` already decides WHETHER someone may read a matter. Nothing
/// recorded THAT IT HAPPENED, and the PDPA expects access to privileged
/// material to be accountable.
///
/// ─────────────────────────────────────────────────────────────────────────
/// This model deliberately holds NO CONTENT.
///
/// There is no column for the matter description, the conflict-check note, or
/// any excerpt of what was read — not even a truncated one. A log of *who read
/// a matter description* is an accountability record. A log that copies the
/// description into itself is a second privileged store, in a table with
/// different access rules and a different retention period, and it is a new
/// place for privilege to leak. The absence of a content column is the
/// guardrail, exactly as it is on `FeeNote`.
/// ─────────────────────────────────────────────────────────────────────────
model DataAccessLog {
  id String @id @default(uuid())

  /// The person who read it. Not a relation: the log must survive the erasure
  /// of the actor's account, or it stops being an audit trail.
  actorUserId String
  /// Their firm role at the time, or 'ADMIN' / 'CLIENT'. Denormalised because
  /// roles change and the log must say what was true that day.
  actorRole   String

  resource   AuditedResource
  resourceId String
  action     AuditedAction

  /// The matter and firm this touched, for firm-scoped review. Denormalised
  /// for the same reason as `actorRole`.
  bookingId String?
  firmId    String?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([firmId, createdAt])
  @@index([createdAt])
}

enum SubjectRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  PORTABILITY
  OBJECTION
}

enum SubjectRequestStatus {
  RECEIVED
  IN_PROGRESS
  /// Matter data is the FIRM's to decide on. We hold it as processor and
  /// cannot release or delete it on our own authority.
  AWAITING_FIRM
  COMPLETED
  /// Some of it was done and some refused — the normal outcome for erasure,
  /// where a firm's retention duty outlives the request.
  PARTIALLY_FULFILLED
  REFUSED
}

/// A data-subject request under the PDPA.
///
/// The endpoints are the easy part. The hard part is that a request spanning
/// matter data has TWO decision-makers: we answer for the data we control, and
/// the firm answers for the matter file it controls. `AWAITING_FIRM` is that
/// split made explicit rather than hidden in a support inbox.
model DataSubjectRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   SubjectRequestType
  status SubjectRequestStatus @default(RECEIVED)

  /// What the person actually asked for, in their words.
  requestNote String?

  /// Firms that hold matter data caught by this request and must decide for
  /// themselves. Denormalised ids: this is a worklist, not a relation.
  referredFirmIds String[]

  /// The statutory clock. Recorded rather than computed at read time so that
  /// changing the period later does not silently re-date open requests.
  dueBy DateTime

  /// What we did, and — where we refused — why. A refusal that does not say
  /// which duty required the retention is not a defensible refusal.
  outcomeNote   String?
  refusalReason String?

  handledById String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// What each referred firm decided. One row per firm — see the comment on
  /// `SubjectRequestFirmResponse`.
  firmResponses SubjectRequestFirmResponse[]

  @@index([userId, status])
  @@index([status, dueBy])
}

/// What a law firm decided about the part of a subject request that touches
/// its own matter file.
enum FirmSubjectResponseOutcome {
  /// The firm gave the person their matter data.
  RELEASED
  /// The firm deleted it.
  ERASED
  /// The firm holds a matter for this person and is keeping it. `reason` must
  /// name the duty — a refusal that does not is not a defensible refusal.
  REFUSED_RETAINED
  /// Some released or erased, some kept.
  PARTIAL
  /// The firm holds nothing for this person.
  NO_DATA
}

/// One law firm's decision on one data-subject request.
///
/// ───────────────────────────────────────────────────────────────────────────
/// WHY THIS IS A SEPARATE ROW PER FIRM RATHER THAN A FIELD ON THE REQUEST.
///
/// `DataSubjectRequest` has one `status` and one `outcomeNote`, but
/// `referredFirmIds` is a LIST: a person who has engaged two practices has one
/// request that two different controllers must each answer. If a firm wrote its
/// decision onto the shared row, the first firm to respond would close the
/// request for the second, and its words would be published to the subject as
/// though they were ours.
///
/// So each firm answers for itself, here, and the parent request advances only
/// when every referred firm has responded — computed in
/// `src/lib/privacy/firmResponse.ts`, never guessed from the first reply.
///
/// A firm can only ever see and write its OWN row. Telling firm A that firm B
/// also holds a matter for this client would disclose the existence of the
/// other retainer, which is not ours to disclose.
///
/// NOTE WHAT IS NOT HERE: no matter content. `reason` is the firm's message to
/// its own client about what it decided and which duty required it. It is not a
/// place to copy the file into, for the same reason `DataAccessLog` has no
/// content column.
/// ───────────────────────────────────────────────────────────────────────────
model SubjectRequestFirmResponse {
  id String @id @default(uuid())

  requestId String
  request   DataSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  firmId String
  firm   LawFirm @relation(fields: [firmId], references: [id])

  outcome FirmSubjectResponseOutcome

  /// The firm's own words to the person, naming the duty where it is keeping
  /// something. Required: an outcome with no reason is not an answer.
  reason String

  /// Who at the firm decided. Not a relation: this must survive the erasure of
  /// that person's account, exactly like `DataAccessLog.actorUserId`.
  respondedById String?

  respondedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// A firm answers a given request once. Re-deciding updates its own row.
  @@unique([requestId, firmId])
  @@index([firmId, respondedAt])
}

/// ───────────────────────────────────────────────────────────────────────────
/// The public directory switch — append-only.
///
/// Whether the consumer directory (`/lawyers`, `/firms` and their APIs) is shown
/// at all. Counsel questions 16–18 ask whether it may lawfully exist; if the
/// answer is no, an administrator turns it off here instead of shipping a
/// release. See docs/DIRECTION.md §2.
///
/// The current state is the NEWEST row. No rows means ON, which is how the
/// product behaved before the switch existed. Rows are never edited or deleted:
/// "when was the directory taken down, by whom, and why" is a question a
/// regulator can ask, and the answer is this table.
/// ───────────────────────────────────────────────────────────────────────────
model DirectorySwitch {
  id String @id @default(uuid())

  enabled Boolean

  /// Required: a switch flipped with no reason is not a decision anyone can defend.
  reason String

  /// Not a relation, so it survives the erasure of that person's account,
  /// like `DataAccessLog.actorUserId`.
  changedById String

  createdAt DateTime @default(now())

  @@index([createdAt])
}
