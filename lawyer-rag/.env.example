# ── The chat model ──────────────────────────────────────────────────────────
#
# Two settings decide which model answers a legal question, and this is the ONLY
# place either is named. config.py reads them and app/core/llm.py builds the
# client. Do not add a model name to a docstring, a script or a README: there
# were once four different model names across five files, and nobody could say
# which one a user's question actually reached.
#
#   LLM_PROVIDER=ollama   local inference; the question never leaves the machine
#   LLM_PROVIDER=google   hosted inference; the question LEAVES SRI LANKA
#
# Keep this local unless you have read the preconditions in
# app/core/llm.py._build_google. A hosted provider is a cross-border transfer
# of personal data and an undisclosed sub-processor until someone discloses it —
# the same shape as the LangSmith leak Stage 0 closed. Measuring a candidate
# against eval/questions.yaml is fine; those are authored test questions and
# contain no real person's data. Pointing real users at it is not, yet.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

OLLAMA_BASE_URL=http://localhost:11434

# Required only when LLM_PROVIDER=google. The service refuses to start without
# it in that case, rather than failing on the first question a user asks.
#
# A Generative Language API key — NOT the Google OAuth client secret or the Maps
# key in lawyer-finder-web/.env. Same vendor, different credential, and a
# different lawful basis: an email address for a login and the facts of someone's
# legal problem are different data for a different purpose.
#
# Check the tier before using it. Google's FREE API tier is documented as using
# submitted prompts to improve its products. For a legal assistant that means the
# text of real legal questions could become training data — a worse outcome than
# the LangSmith leak Stage 0 closed, because that was retention, not absorption.
# GOOGLE_API_KEY=

# How long to wait on a hosted provider. The Next.js caller gives up at 60s and
# the gunicorn worker at 120s, so a longer wait here is a wait for a reply
# nobody is listening for.
LLM_TIMEOUT_SECONDS=90

# Embeddings are ALWAYS local, whichever chat provider is set. Changing this
# invalidates data/vectordb — the corpus and the query must be embedded by the
# same model — so it means a re-ingest AND a fresh RETRIEVAL_MIN_SCORE sweep.
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION_NAME=sri_lanka_legal_acts

# Flask
# 127.0.0.1 by default and it should stay that way: the only legitimate caller
# is the Next.js server. Do not set 0.0.0.0.
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
# Never true outside a local machine. The Werkzeug debugger is an interactive
# Python console for anyone who can reach the port and make the app throw.
FLASK_DEBUG=false

# REQUIRED. The service will not start without it.
#
# The shared secret that every caller must present as X-Service-Token, checked
# in a before_request hook on every route. Must be identical to
# RAG_SERVICE_TOKEN in lawyer-finder-web/.env.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RAG_SERVICE_TOKEN=

# RAG Configuration
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K_RESULTS=6

# Request limits
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_TURNS=10
MAX_CONTENT_LENGTH_MB=50

# Generation limits. num_ctx must stay well above what one agent run puts in the
# context: TOP_K_RESULTS x CHUNK_SIZE characters per vector_search, re-sent on
# every ReAct step. At 8192 it overflowed silently and the safety prompt was
# among the things that could be truncated away.
LLM_NUM_CTX=32768
LLM_NUM_PREDICT=1536

# Acts source directory (absolute path to your Acts folder)
ACTS_SOURCE_DIR=../Acts

# Tracing — leave FALSE.
#
# When this was true, LangSmith received the full text of every question asked
# of a legal assistant, the legislation retrieved for it and the answer
# generated — sensitive personal data, no lawful basis, an undocumented transfer
# out of Sri Lanka, and a sub-processor no firm was told about.
#
# Before turning it on: self-host the collector or mask inputs and outputs, and
# record the sub-processor in
# lawyer-finder-web/docs/restructure/DATA-INVENTORY.md.
RAG_TRACING_ENABLED=false
LANGCHAIN_PROJECT=lawyer-rag
